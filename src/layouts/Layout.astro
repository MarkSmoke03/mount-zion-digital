---
interface Props {
  title: string;
}
const { title } = Astro.props;
const currentYear = new Date().getFullYear();
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title} | Mount Zion Christian Centre Kitwe - Transforming Lives</title>
  
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Playfair+Display:ital,wght@0,600;0,700;1,600&display=swap" rel="stylesheet">
  
  <style>
    /* Kept base global rules in standard CSS */
    body {
      font-family: 'Inter', sans-serif;
      -webkit-font-smoothing: antialiased;
    }
    h1, h2, h3, .serif-heading {
      font-family: 'Playfair Display', serif;
    }
  </style>
</head>
<body class="m-0 p-0 bg-white text-gray-800">
  <!-- OFFICIAL MTZ STICKY NAVIGATION -->
  <nav class="fixed top-0 left-0 w-full bg-white shadow-sm z-50 border-b-[3px] border-navy">
    <div class="max-w-7xl mx-auto py-4 px-6 flex justify-between items-center">

      <!-- LOGO INTEGRATION -->
      <a href="/" class="flex items-center gap-3 no-underline">
        <img src="/images/mtz-logo.png" alt="Mount Zion Logo" class="h-12 w-auto object-contain" />
        <div>
          <span class="font-sans text-gray-900 font-extrabold text-xl tracking-tight block leading-none">Mount Zion</span>
          <span class="font-sans text-gray-500 text-[11px] tracking-widest uppercase block mt-1 font-semibold">Christian Centre • Kitwe</span>
        </div>
      </a>

      <!-- Main Navigation Links (desktop only) -->
      <div class="hidden md:flex gap-7 items-center">
        <a href="/" class="text-gray-700 hover:text-navy no-underline text-sm font-semibold transition-colors">Home</a>
        <a href="/ministries" class="text-gray-700 hover:text-navy no-underline text-sm font-semibold transition-colors">Get Connected</a>
        <a href="/prayer-hub" class="text-gray-700 hover:text-navy no-underline text-sm font-semibold transition-colors">Prayer & Care</a>
        <a href="/connect" class="text-gray-700 hover:text-navy no-underline text-sm font-semibold transition-colors">Connect With Us</a>
        <a href="/plan-your-visit" class="text-white text-sm font-semibold py-2.5 px-6 rounded bg-navy hover:bg-navy-dark transition-colors no-underline">Join Us for Worship</a>
      </div>

      <!-- Mobile menu toggle -->
      <button
        id="mobile-menu-toggle"
        type="button"
        class="md:hidden p-2 -mr-2"
        aria-label="Toggle menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg id="icon-open" xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-navy" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg id="icon-close" xmlns="http://www.w3.org/2000/svg" class="hidden h-6 w-6 text-navy" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <!-- Mobile menu (collapsed by default, toggled by the script below) -->
    <div id="mobile-menu" class="hidden md:hidden flex-col bg-white border-t border-gray-100 px-6 pb-4">
      <a href="/" class="block py-3 text-gray-700 hover:text-navy no-underline text-sm font-semibold border-b border-gray-100">Home</a>
      <a href="/ministries" class="block py-3 text-gray-700 hover:text-navy no-underline text-sm font-semibold border-b border-gray-100">Get Connected</a>
      <a href="/prayer-hub" class="block py-3 text-gray-700 hover:text-navy no-underline text-sm font-semibold border-b border-gray-100">Prayer & Care</a>
      <a href="/connect" class="block py-3 text-gray-700 hover:text-navy no-underline text-sm font-semibold border-b border-gray-100">Connect With Us</a>
      <a href="/plan-your-visit" class="block text-center mt-3 text-white text-sm font-semibold py-2.5 px-6 rounded bg-navy hover:bg-navy-dark transition-colors no-underline">Join Us for Worship</a>
    </div>
  </nav>

  <script>
    const toggle = document.getElementById('mobile-menu-toggle') as HTMLButtonElement;
    const menu = document.getElementById('mobile-menu') as HTMLElement;
    const iconOpen = document.getElementById('icon-open') as HTMLElement;
    const iconClose = document.getElementById('icon-close') as HTMLElement;

    if (toggle && menu && iconOpen && iconClose) {
      const setOpen = (open: boolean) => {
        menu.classList.toggle('hidden', !open);
        menu.classList.toggle('flex', open);
        iconOpen.classList.toggle('hidden', open);
        iconClose.classList.toggle('hidden', !open);
        toggle.setAttribute('aria-expanded', String(open));
      };

      toggle.addEventListener('click', () => {
        setOpen(menu.classList.contains('hidden'));
      });

      // If the window is resized/rotated past the desktop breakpoint while
      // the mobile menu is open, close it so it can't get stuck open behind
      // the desktop nav (768px matches Tailwind's default `md:` breakpoint).
      window.matchMedia('(min-width: 768px)').addEventListener('change', (e) => {
        if (e.matches) setOpen(false);
      });
    }
  </script>

  <!-- MAIN HOUSING LAYER -->
  <main class="pt-[85px] min-h-[85vh]">
    <slot />
  </main>

  <!-- OFFICIAL MTZ FOOTER -->
  <footer class="bg-gray-900 text-gray-50 pt-20 pb-8 px-6">
    <div class="max-w-7xl mx-auto grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-12 mb-16">
      
      <!-- Vision & Mission -->
      <div>
        <h3 class="font-sans text-white text-lg mt-0 mb-5 font-bold uppercase tracking-wide">Our Vision & Mission</h3>
        <p class="text-gray-400 text-sm leading-relaxed mb-4">
          <strong class="text-gray-200">Vision:</strong> To preach the Prophetic Now Word of God that uplifts, heals and provides practical solutions for life.
        </p>
        <p class="text-gray-400 text-sm leading-relaxed m-0">
          <strong class="text-gray-200">Mission:</strong> To be a christ-centered Church, carrying the manifest presence of God that permanently sets people free, to actualize their purpose and corporately fulfill kingdom assignment.
        </p>
      </div>

      <!-- Service Times -->
      <div>
        <h3 class="font-sans text-white text-lg mt-0 mb-5 font-bold uppercase tracking-wide">Join Us for Worship</h3>
        <ul class="list-none p-0 m-0 text-sm leading-loose">
          <li class="mb-3 border-b border-white/10 pb-2">
            <strong class="text-white block">Sunday Morning Service</strong>
            <span class="text-gray-400">09:00 AM</span>
          </li>
          <li class="mb-3 border-b border-white/10 pb-2">
            <strong class="text-white block">Wednesday Midweek Service</strong>
            <span class="text-gray-400">18:00 PM</span>
          </li>
          <li class="mb-3 pb-2">
            <strong class="text-white block">Saturday Intercession</strong>
            <span class="text-gray-400">20:30 PM</span>
          </li>
        </ul>
      </div>

      <!-- Kitwe Branch Info -->
      <div>
        <h3 class="font-sans text-white text-lg mt-0 mb-5 font-bold uppercase tracking-wide">Kitwe Branch Details</h3>
        <p class="text-gray-400 text-sm leading-relaxed mt-0 mb-4">
          <strong class="text-gray-200 block mb-1">Branch Pastor:</strong>
          Pastor Morgan Bwalya
        </p>
        <p class="text-gray-400 text-sm leading-relaxed mt-0 mb-5">
          <strong class="text-gray-200 block mb-1">Location:</strong>
          Mount Zion Christian Center, Kitwe, Zambia.
        </p>
        <a href="tel:+260962216561" class="text-white text-base font-semibold no-underline inline-flex items-center gap-2 bg-white/5 py-2.5 px-4 rounded border border-white/10 hover:bg-white/10 transition-colors">
          Call Us: +260 962 216 561
        </a>
      </div>

    </div>

    <!-- Copyright -->
    <div class="max-w-7xl mx-auto border-t border-white/10 pt-6 text-left text-sm text-gray-500 flex justify-between flex-wrap gap-4">
      <p class="m-0">&copy; {currentYear} Mount Zion Christian Centre. All Rights Reserved.</p>
      <p class="m-0">Transforming Lives to Transform the World.</p>
    </div>
  </footer>
</body>
</html>