---
import { church, services } from '../data/church';

interface Props {
  title: string;
  description?: string;
  /** Path to a share image under /public, used for WhatsApp/Facebook link previews. */
  image?: string;
}

const {
  title,
  description = 'Mount Zion Christian Centre Kitwe – a Bible-believing church led by Pastor Morgan Bwalya. Join us on Sundays at 09:00 and experience the manifest presence of God.',
  image = '/images/og-share.jpg',
} = Astro.props;

const siteName = `${church.name} ${church.branch}`;
const fullTitle = title === 'Home' ? `${siteName} – Transforming Lives` : `${title} | ${siteName}`;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).href;
const imageUrl = new URL(image, Astro.site).href;
const currentYear = new Date().getFullYear();

const navLinks = [
  { href: '/', label: 'Home' },
  { href: '/about', label: 'About' },
  { href: '/ministries', label: 'Get Connected' },
  { href: '/prayer-hub', label: 'Prayer & Care' },
  { href: '/connect', label: 'Connect With Us' },
  { href: '/partner', label: 'Partner With Us' },
];

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => (href === '/' ? currentPath === '/' : currentPath === href);
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalUrl} />
  <meta name="theme-color" content="#1a365d" />

  <!-- Icons -->
  <link rel="icon" href="/favicon.ico" sizes="32x32" />
  <link rel="icon" type="image/png" href="/favicon-192.png" sizes="192x192" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

  <!-- Link previews (WhatsApp, Facebook, X) -->
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content={siteName} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:image" content={imageUrl} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:locale" content="en_ZM" />
  <meta name="twitter:card" content="summary_large_image" />

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Playfair+Display:wght@600;700&display=swap" rel="stylesheet">

  <style>
    body {
      font-family: 'Inter', sans-serif;
      -webkit-font-smoothing: antialiased;
    }
    /* Display serif is reserved for page titles and large section headings.
       Everything else stays in Inter. */
    h1, .serif-heading {
      font-family: 'Playfair Display', serif;
    }
  </style>
</head>
<body class="m-0 p-0 bg-white text-gray-800">
  <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-[60] focus:bg-white focus:text-navy focus:px-4 focus:py-2 focus:rounded focus:shadow">Skip to content</a>

  <!-- STICKY NAVIGATION -->
  <nav class="fixed top-0 left-0 w-full bg-white shadow-sm z-50 border-b-[3px] border-navy" aria-label="Main">
    <div class="max-w-7xl mx-auto py-4 px-4 sm:px-6 flex justify-between items-center gap-4">

      <a href="/" class="flex items-center gap-2.5 sm:gap-3 no-underline min-w-0">
        <img src="/images/mtz-mark.png" alt="" width="80" height="48" class="h-12 w-auto shrink-0" />
        <div class="min-w-0">
          <span class="text-gray-900 font-extrabold text-xl tracking-tight block leading-none">Mount Zion</span>
          <span class="text-gray-500 text-[11px] tracking-wider sm:tracking-widest uppercase block mt-1 font-semibold whitespace-nowrap">Christian Centre • Kitwe</span>
        </div>
      </a>

      <!-- Desktop links: only from 1280px up, where all seven items fit on one line -->
      <div class="hidden xl:flex gap-6 items-center">
        {navLinks.map((link) => (
          <a
            href={link.href}
            aria-current={isActive(link.href) ? 'page' : undefined}
            class:list={[
              'no-underline text-sm font-semibold transition-colors whitespace-nowrap hover:text-navy',
              isActive(link.href) ? 'text-navy' : 'text-gray-700',
            ]}
          >{link.label}</a>
        ))}
        <a href="/plan-your-visit" class="text-white text-sm font-semibold py-2.5 px-6 rounded bg-navy hover:bg-navy-dark transition-colors no-underline whitespace-nowrap">Join Us for Worship</a>
      </div>

      <button
        id="mobile-menu-toggle"
        type="button"
        class="xl:hidden p-2 -mr-2 shrink-0"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg id="icon-open" xmlns="http://www.w3.org/2000/svg" class="h-7 w-7 text-navy" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg id="icon-close" xmlns="http://www.w3.org/2000/svg" class="hidden h-7 w-7 text-navy" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <div id="mobile-menu" class="hidden xl:hidden flex-col bg-white border-t border-gray-100 px-4 sm:px-6 pb-4 max-h-[calc(100vh-85px)] overflow-y-auto">
      {navLinks.map((link) => (
        <a
          href={link.href}
          aria-current={isActive(link.href) ? 'page' : undefined}
          class:list={[
            'block py-3.5 no-underline text-base font-semibold border-b border-gray-100 hover:text-navy',
            isActive(link.href) ? 'text-navy' : 'text-gray-700',
          ]}
        >{link.label}</a>
      ))}
      <a href="/plan-your-visit" class="block text-center mt-4 text-white text-base font-semibold py-3 px-6 rounded bg-navy hover:bg-navy-dark transition-colors no-underline">Join Us for Worship</a>
    </div>
  </nav>

  <script>
    const toggle = document.getElementById('mobile-menu-toggle') as HTMLButtonElement;
    const menu = document.getElementById('mobile-menu') as HTMLElement;
    const iconOpen = document.getElementById('icon-open') as HTMLElement;
    const iconClose = document.getElementById('icon-close') as HTMLElement;

    if (toggle && menu && iconOpen && iconClose) {
      const setOpen = (open: boolean) => {
        menu.classList.toggle('hidden', !open);
        menu.classList.toggle('flex', open);
        iconOpen.classList.toggle('hidden', open);
        iconClose.classList.toggle('hidden', !open);
        toggle.setAttribute('aria-expanded', String(open));
        toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
      };

      toggle.addEventListener('click', () => {
        setOpen(menu.classList.contains('hidden'));
      });

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && !menu.classList.contains('hidden')) {
          setOpen(false);
          toggle.focus();
        }
      });

      // Close the mobile menu if the window grows past the desktop breakpoint
      // (1280px = Tailwind's `xl:`), so it can't get stuck open.
      window.matchMedia('(min-width: 1280px)').addEventListener('change', (e) => {
        if (e.matches) setOpen(false);
      });
    }
  </script>

  <main id="main" class="pt-[85px] min-h-[85vh]">
    <slot />
  </main>

  <!-- FOOTER -->
  <footer class="bg-gray-900 text-gray-50 pt-16 md:pt-20 pb-8 px-6">
    <div class="max-w-7xl mx-auto grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-12 mb-16">

      <div>
        <h2 class="text-white text-lg mt-0 mb-5 font-bold uppercase tracking-wide">{church.mission ? 'Our Vision & Mission' : 'Our Vision'}</h2>
        <p class="text-gray-400 text-sm leading-relaxed mb-4">
          <strong class="text-gray-200">Vision:</strong> {church.vision}
        </p>
        {church.mission && (
          <p class="text-gray-400 text-sm leading-relaxed m-0">
            <strong class="text-gray-200">Mission:</strong> {church.mission}
          </p>
        )}
      </div>

      <div>
        <h2 class="text-white text-lg mt-0 mb-5 font-bold uppercase tracking-wide">Join Us for Worship</h2>
        <ul class="list-none p-0 m-0 text-sm">
          {services.map((s, i) => (
            <li class:list={['py-2.5', i < services.length - 1 && 'border-b border-white/10']}>
              <strong class="text-white block">{s.name}</strong>
              <span class="text-gray-400">
                {s.day}{s.time && ` · ${s.time}`}
                {s.online && <span class="ml-2 inline-block text-[11px] font-semibold uppercase tracking-wide text-gold border border-gold/50 rounded px-1.5 py-px align-middle">Online</span>}
              </span>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <h2 class="text-white text-lg mt-0 mb-5 font-bold uppercase tracking-wide">Kitwe Branch Details</h2>
        <p class="text-gray-400 text-sm leading-relaxed mt-0 mb-4">
          <strong class="text-gray-200 block mb-1">Branch Pastor:</strong>
          <a href="/about" class="text-gray-400 hover:text-white underline-offset-2 hover:underline">{church.pastor}</a>
        </p>
        <p class="text-gray-400 text-sm leading-relaxed mt-0 mb-5">
          <strong class="text-gray-200 block mb-1">Location:</strong>
          {church.location}
        </p>
        <a href={`tel:${church.phone.tel}`} class="text-white text-base font-semibold no-underline inline-flex items-center gap-2 bg-white/5 py-2.5 px-4 rounded border border-white/10 hover:bg-white/10 transition-colors">
          Call Us: {church.phone.display}
        </a>
      </div>

    </div>

    <div class="max-w-7xl mx-auto border-t border-white/10 pt-6 text-left text-sm text-gray-500 flex justify-between flex-wrap gap-4">
      <p class="m-0">&copy; {currentYear} {church.name}. All Rights Reserved.</p>
      <p class="m-0">{church.tagline}</p>
    </div>
  </footer>
</body>
</html>
