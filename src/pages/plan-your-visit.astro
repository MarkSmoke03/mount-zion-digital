---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Join Us for Worship">
  <!-- Header -->
  <section class="bg-gray-100 py-20 px-6 text-center">
    <h1 class="text-4xl md:text-5xl mb-4 text-gray-900 font-bold">Join Us for Worship</h1>
    <p class="max-w-2xl mx-auto text-gray-600 text-lg leading-relaxed">
      At Mount Zion Christian Centre, we offer a fresh perspective to church life for the entire family. Visit our Kitwe branch this week.
    </p>
  </section>

  <section class="max-w-7xl mx-auto my-20 px-6 grid grid-cols-1 md:grid-cols-2 gap-16">
    
    <!-- Service Times -->
    <div>
      <h2 class="serif-heading text-3xl text-gray-900 mb-8 font-bold">Service Times</h2>
      
      <div class="mb-6">
        <h3 class="text-lg text-navy mb-1 font-bold">Sunday Services</h3>
        <p class="text-gray-600 text-base mb-1">First Service - 09:00 AM</p>
        <p class="text-gray-600 text-base m-0">The Garage (Youth) - 11:30 AM</p>
      </div>
      <div class="mb-6">
        <h3 class="text-lg text-navy mb-1 font-bold">Midweek Service</h3>
        <p class="text-gray-600 text-base m-0">Wednesday - 6:00 PM</p>
      </div>
      <div class="mb-6">
        <h3 class="text-lg text-navy mb-1 font-bold">PLUG & Discipleship</h3>
        <p class="text-gray-600 text-base m-0">Online Connect Group - 6:00 PM</p>
      </div>

      <div class="mt-10 p-6 bg-gray-900 rounded-lg text-white">
        <h3 class="text-lg mb-3 font-semibold">Contact Kitwe Branch</h3>
        <p class="text-gray-400 text-sm mb-1">Pastor Morgan Bwalya</p>
        <p class="text-gray-400 text-sm mb-4">Call Us: +260 962 216 561</p>
        <p class="text-gray-300 text-sm m-0">Mount Zion Christian Center, Kitwe, Zambia.</p>
      </div>
    </div>

    <!-- Map Framework -->
    <div>
      <h2 class="serif-heading text-3xl text-gray-900 mb-8 font-bold">Visit Us</h2>
      <div class="w-full h-[450px] bg-gray-200 rounded-lg overflow-hidden border border-gray-300 flex items-center justify-center">
        <!-- GOOGLE MAPS IFRAME -->
        <iframe 
          src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d972.7621378834009!2d28.202265329246003!3d-12.775358989158876!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x196ce595b0e5b467%3A0xe454f35b2cc84207!2sMount%20Zion%20Christian%20Center%20Kitwe!5e0!3m2!1sen!2szm!4v1784219862490!5m2!1sen!2szm" 
          width="100%" 
          height="100%" 
          style="border:0;" 
          allowfullscreen="" 
          loading="lazy" 
          referrerpolicy="strict-origin-when-cross-origin">
        </iframe>
      </div>
    </div>
    
  </section>
</Layout>