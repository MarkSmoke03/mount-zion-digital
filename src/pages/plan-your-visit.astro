---
import Layout from '../layouts/Layout.astro';
import { church, services, plug } from '../data/church';
---

<Layout
  title="Join Us for Worship"
  description="Service times and directions for Mount Zion Christian Centre Kitwe. Sunday service at 09:00, midweek service on Wednesday at 18:00, plus online prayer."
>
  <section class="bg-gray-100 py-16 md:py-20 px-6 text-center">
    <h1 class="text-4xl md:text-5xl mb-4 text-gray-900 font-bold">Join Us for Worship</h1>
    <p class="max-w-2xl mx-auto text-gray-600 text-lg leading-relaxed">
      At Mount Zion Christian Centre, we offer a fresh perspective to church life for the entire family. Visit our Kitwe branch this week.
    </p>
  </section>

  <section class="max-w-7xl mx-auto my-16 md:my-20 px-6 grid grid-cols-1 md:grid-cols-2 gap-12 md:gap-16">

    <div>
      <h2 class="serif-heading text-3xl text-gray-900 mb-8 font-bold">Service Times</h2>

      <ul class="list-none p-0 m-0 divide-y divide-gray-200 border-y border-gray-200">
        {services.map((s) => (
          <li class="py-4 flex items-start justify-between gap-4">
            <div>
              <h3 class="text-lg text-navy m-0 font-bold">{s.name}</h3>
              <p class="text-gray-600 text-sm mt-1 mb-0">
                {s.online ? 'Online' : 'In person at the church'}
              </p>
            </div>
            <div class="text-right shrink-0">
              <p class="text-gray-900 font-semibold m-0">{s.day}</p>
              {s.time && <p class="text-gray-600 m-0">{s.time}</p>}
            </div>
          </li>
        ))}
      </ul>

      <div class="mt-8 rounded-lg border border-gray-200 p-5">
        <h3 class="text-lg text-navy m-0 mb-1 font-bold">{plug.name}</h3>
        <p class="text-gray-600 text-[15px] leading-relaxed mt-0 mb-3">{plug.description}</p>
        <a href="/connect" class="text-navy font-semibold text-sm no-underline hover:underline">Ask about joining a group →</a>
      </div>

      <div class="mt-10 p-6 bg-gray-900 rounded-lg text-white">
        <h3 class="text-lg mt-0 mb-3 font-semibold">Contact Kitwe Branch</h3>
        <p class="text-gray-300 text-sm mb-1">{church.pastor}</p>
        <p class="text-sm mb-4">
          <a href={`tel:${church.phone.tel}`} class="text-white font-semibold no-underline hover:underline">Call Us: {church.phone.display}</a>
        </p>
        <p class="text-gray-300 text-sm m-0">{church.location}</p>
      </div>
    </div>

    <div>
      <h2 class="serif-heading text-3xl text-gray-900 mb-8 font-bold">Visit Us</h2>
      <div class="w-full h-[360px] md:h-[450px] bg-gray-200 rounded-lg overflow-hidden border border-gray-300">
        <iframe
          title="Map showing Mount Zion Christian Centre, Kitwe"
          src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d972.7621378834009!2d28.202265329246003!3d-12.775358989158876!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x196ce595b0e5b467%3A0xe454f35b2cc84207!2sMount%20Zion%20Christian%20Center%20Kitwe!5e0!3m2!1sen!2szm!4v1784219862490!5m2!1sen!2szm"
          width="100%"
          height="100%"
          style="border:0;"
          allowfullscreen=""
          loading="lazy"
          referrerpolicy="strict-origin-when-cross-origin">
        </iframe>
      </div>
      <a
        href="https://www.google.com/maps/search/?api=1&query=Mount+Zion+Christian+Center+Kitwe"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-block mt-4 text-navy font-semibold text-sm no-underline hover:underline"
      >Open in Google Maps for directions →</a>
    </div>

  </section>
</Layout>
