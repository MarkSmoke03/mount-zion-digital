---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Prayer & Care">

  <section class="max-w-4xl mx-auto my-20 px-6">
    <div class="text-center mb-12">
      <h1 class="text-4xl md:text-5xl mb-4 text-gray-900 font-bold">Prayer & Care</h1>
      <p class="text-gray-600 text-base leading-relaxed italic mb-5">
        "But on Mount Zion there shall be deliverance, And there shall be holiness; The house of Jacob shall possess their possessions." — Obadiah 1:17
      </p>
      <p class="text-gray-600 text-base leading-relaxed">
        We believe in the manifest presence of God that permanently sets people free. Submit your prayer request to Pastor Morgan Bwalya and our Spiritual Foundation team.
      </p>
    </div>

    <div class="bg-white p-10 rounded-lg border border-gray-200 shadow-sm">
      <form id="mtzPrayerForm" class="flex flex-col gap-6">

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div>
            <label for="fullName" class="block text-sm font-semibold text-gray-700 mb-2">Full Name</label>
            <input type="text" id="fullName" required class="w-full px-4 py-3 border border-gray-300 rounded text-base focus:outline-none focus:border-navy focus:ring-1 focus:ring-navy" />
          </div>
          <div>
            <label for="phoneNumber" class="block text-sm font-semibold text-gray-700 mb-2">Phone Number</label>
            <input type="tel" id="phoneNumber" required class="w-full px-4 py-3 border border-gray-300 rounded text-base focus:outline-none focus:border-navy focus:ring-1 focus:ring-navy" />
          </div>
        </div>

        <div>
          <label for="prayerMessage" class="block text-sm font-semibold text-gray-700 mb-2">Prayer Request / Message</label>
          <textarea id="prayerMessage" required rows="6" class="w-full px-4 py-3 border border-gray-300 rounded text-base resize-y focus:outline-none focus:border-navy focus:ring-1 focus:ring-navy"></textarea>
        </div>

        <div class="flex items-start gap-2.5">
          <input type="checkbox" id="privateCheck" class="mt-1" />
          <label for="privateCheck" class="text-sm text-gray-600">Keep this request confidential for Pastoral Leadership only.</label>
        </div>

        <button type="submit" class="bg-navy hover:bg-navy-dark text-white text-base font-semibold py-3 px-7 rounded mt-3 transition-colors cursor-pointer border-none self-start">
          Send Message
        </button>
      </form>
    </div>
  </section>

  <script>
    const form = document.getElementById('mtzPrayerForm') as HTMLFormElement;

    if (form) {
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        const name = (document.getElementById('fullName') as HTMLInputElement).value;
        const phone = (document.getElementById('phoneNumber') as HTMLInputElement).value;
        const msg = (document.getElementById('prayerMessage') as HTMLTextAreaElement).value;
        const isPrivate = (document.getElementById('privateCheck') as HTMLInputElement).checked;

        let text = `*MTZ KITWE PRAYER CONNECT*\n\n*Name:* ${name}\n*Phone:* ${phone}\n\n*Message:*\n${msg}\n\n`;
        text += isPrivate ? `*(CONFIDENTIAL)*` : `*(GENERAL)*`;

        // NOTE: this number differs from the +260 962 216 561 shown in the
        // footer and on the Plan Your Visit page - worth confirming which
        // one should actually receive these messages.
        window.open(`https://wa.me/260962219190?text=${encodeURIComponent(text)}`, '_blank');
      });
    }
  </script>

</Layout>