---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Page Not Found" description="This page could not be found.">
  <section class="max-w-2xl mx-auto py-24 md:py-32 px-6 text-center">
    <p class="text-sm font-bold text-navy uppercase tracking-widest mb-4">Error 404</p>
    <h1 class="text-4xl md:text-5xl text-gray-900 font-bold mb-5">We couldn't find that page.</h1>
    <p class="text-gray-600 text-lg leading-relaxed mb-10">
      The link may be old or mistyped. Here are some places to start instead.
    </p>
    <div class="flex flex-wrap gap-3 justify-center">
      <a href="/" class="bg-navy hover:bg-navy-dark text-white font-semibold no-underline py-3 px-6 rounded transition-colors">Go to Home</a>
      <a href="/plan-your-visit" class="border-2 border-navy text-navy hover:bg-navy hover:text-white font-semibold no-underline py-2.5 px-6 rounded transition-colors">Service Times</a>
      <a href="/connect" class="border-2 border-navy text-navy hover:bg-navy hover:text-white font-semibold no-underline py-2.5 px-6 rounded transition-colors">Connect With Us</a>
    </div>
  </section>
</Layout>
