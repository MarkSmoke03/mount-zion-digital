---
import Layout from '../layouts/Layout.astro';
import { church, discipleship } from '../data/church';

interface Ministry {
  id: string;
  name: string;
  description: string;
  image: string;
  imageAlt: string;
  /** Posters are shown whole (letterboxed) instead of cropped like photos. */
  poster?: boolean;
  /** What the expanded card says and where it points. Defaults to the Connect form. */
  detail?: string;
  link?: { href: string; label: string };
}

const ministries: Ministry[] = [
  {
    id: 'garage',
    name: 'The Garage (Youth)',
    description:
      'Empowering the next generation. High-energy worship and relevant teaching for young people. The Garage is church like you have never experienced before.',
    image: '/images/garage-youth.jpg',
    imageAlt: 'Young people from The Garage youth ministry',
  },
  {
    id: 'womens',
    name: "Women's Ministry",
    description:
      'Growing together in faith. Equipping our daughters of Zion to fulfill their strategic roles in family, governance, and commerce.',
    image: '/images/daughters-of-zion.jpg',
    imageAlt: "Members of the Women's Ministry worshipping together",
  },
  {
    id: 'mens',
    name: "Men's Ministry",
    description:
      'Building godly men. His Men is dedicated to raising leaders who provide spiritual foundation and discipleship for their homes and communities.',
    image: '/images/mens-ministry.jpg',
    imageAlt: "Members of the Men's Ministry gathered outdoors",
  },
  {
    id: 'nextgen',
    name: 'Next Generation',
    description:
      'Raising the next leaders in Christ. Grounding the youngest among us in biblical truth to permanently set them on the path of kingdom assignment.',
    image: '/images/next-gen.jpg',
    imageAlt: 'Children in the Next Generation ministry',
  },
  {
    id: 'community',
    name: 'Community Life and Care',
    description:
      'Building a supportive church family. Providing practical solutions, fellowship, and care to ensure nobody walks the journey of faith alone.',
    image: '/images/community-life.jpg',
    imageAlt: 'Church families sharing fellowship',
  },
  {
    id: 'spiritual',
    name: 'Spiritual Foundation',
    description:
      'Grounding lives in biblical truth. Through classes like "Days of Rain", we equip members with the necessary wisdom for ministry at our local assembly.',
    image: '/images/days-of-rain-poster.jpg',
    imageAlt: 'Days of Rain discipleship class poster',
    poster: true,
    detail: 'Every member starts with Days of Rain, our 30-day foundational class, then can go on to Equip.',
    link: { href: '#discipleship', label: 'See the two levels of discipleship' },
  },
];
---

<Layout
  title="Get Connected"
  description="Find your place at Mount Zion Christian Centre Kitwe: The Garage youth ministry, Women's and Men's Ministries, Next Generation, Community Life and Care, Spiritual Foundation, and our two levels of discipleship: Days of Rain and Equip."
>

  <section class="bg-gray-900 text-white py-16 md:py-20 px-6 text-center">
    <h1 class="text-4xl md:text-5xl mb-4 font-bold">Get Connected</h1>
    <p class="max-w-2xl mx-auto text-gray-400 text-lg leading-relaxed">
      Grounding lives in biblical truth. Whether you're seeking to serve or to grow, there is a place for you in the Mount Zion family.
    </p>
  </section>

  <section class="max-w-7xl mx-auto my-16 md:my-20 px-6">
    <!-- min(100%, 320px) keeps cards from overflowing narrow phone screens -->
    <div class="grid grid-cols-[repeat(auto-fit,minmax(min(100%,320px),1fr))] gap-8 md:gap-10 items-start">
      {ministries.map((m) => (
        <div data-tilt class="ministry-card cursor-pointer border border-gray-200 rounded-lg overflow-hidden bg-white shadow-depth hover:shadow-lift hover:border-navy/30">
          <img
            src={m.image}
            alt={m.imageAlt}
            loading="lazy"
            decoding="async"
            width="800"
            height="450"
            class:list={['w-full h-[200px]', m.poster ? 'object-contain bg-gray-50' : 'object-cover']}
          />
          <div class="p-6 md:p-8">
            <h2 class="text-2xl mb-3 text-gray-900 font-bold">{m.name}</h2>
            <p class="text-gray-600 text-[15px] leading-relaxed mb-0">{m.description}</p>
            <div id={`detail-${m.id}`} class="ministry-detail hidden mt-5 pt-5 border-t border-gray-100">
              <p class="text-gray-600 text-[15px] leading-relaxed mb-4">
                {m.detail ?? `Want to get plugged into ${m.name}? Reach out through our Connect page and we'll point you in the right direction.`}
              </p>
              <a href={m.link?.href ?? '/connect'} class="text-navy font-semibold no-underline hover:underline text-sm transition-colors">{m.link?.label ?? 'Get in touch'}</a>
            </div>
            <button type="button" class="ministry-toggle mt-4 flex items-center gap-1.5 text-navy font-semibold text-sm transition-colors hover:text-navy-dark" aria-expanded="false" aria-controls={`detail-${m.id}`}>
              <span class="ministry-toggle-label">Learn more</span>
              <svg class="ministry-chevron w-4 h-4 transition-transform duration-200" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
              </svg>
            </button>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- DISCIPLESHIP: two levels, drawn as two steps. Equip stands higher. -->
  <section id="discipleship" class="bg-gray-100 py-16 md:py-24 px-6 scroll-mt-24" aria-labelledby="discipleship-heading">
    <div class="max-w-6xl mx-auto">
      <div class="max-w-2xl mb-12 md:mb-8">
        <h2 id="discipleship-heading" class="serif-heading text-3xl md:text-5xl text-gray-900 font-bold m-0 mb-4">{discipleship.title}</h2>
        <p class="text-gray-600 text-lg leading-relaxed m-0">{discipleship.intro}</p>
      </div>

      <ol class="list-none p-0 m-0 grid md:grid-cols-2 gap-12 md:gap-14 md:items-end">
        {discipleship.levels.map((lvl, i) => (
          <li class:list={['step-block bg-white rounded-xl border-2 border-navy-dark p-7 md:p-9 mr-[10px]', i > 0 && 'md:mb-24']}>
            <p class="m-0 mb-2 text-sm font-semibold text-gold-dark">Level {lvl.level}{i > 0 && `, after ${discipleship.levels[i - 1].name}`}</p>
            <h3 class="serif-heading text-3xl md:text-4xl text-gray-900 font-bold m-0 mb-4">{lvl.name}</h3>
            <p class="text-gray-700 text-[17px] leading-relaxed m-0 mb-6">{lvl.summary}</p>

            <dl class="m-0 mb-6 grid grid-cols-[auto_1fr] gap-x-5 gap-y-2 text-[15px]">
              {lvl.facts.map((f) => (
                <>
                  <dt class="text-gray-500">{f.label}</dt>
                  <dd class="m-0 font-semibold text-gray-900">{f.value}</dd>
                </>
              ))}
            </dl>

            {lvl.points && (
              <div class="mb-6">
                <h4 class="text-sm font-semibold text-gray-500 m-0 mb-3">{lvl.points.heading}</h4>
                <ul class="list-none p-0 m-0 flex flex-wrap gap-2">
                  {lvl.points.items.map((item) => (
                    <li class="rounded-full bg-navy/5 border border-navy/15 text-navy text-sm font-semibold px-3 py-1">{item}</li>
                  ))}
                </ul>
              </div>
            )}

            <h4 class="text-sm font-semibold text-gray-500 m-0 mb-3">{lvl.joinHeading}</h4>
            {lvl.level === 1 ? (
              <ul class="list-disc m-0 pl-5 space-y-2 text-gray-700 text-[15px] leading-relaxed marker:text-gold-dark">
                {lvl.join.map((line) => <li>{line}</li>)}
              </ul>
            ) : (
              <ol class="list-decimal m-0 pl-5 space-y-2 text-gray-700 text-[15px] leading-relaxed marker:text-gold-dark marker:font-semibold">
                {lvl.join.map((line) => <li>{line}</li>)}
              </ol>
            )}
          </li>
        ))}
      </ol>

      <p class="mt-14 md:mt-6 text-gray-600 text-[15px] m-0">
        Want to know when the next Days of Rain class starts, or how to apply for Equip?
        <a href={`tel:${church.phone.tel}`} class="text-navy font-semibold hover:underline">Call {church.phone.display}</a>
        or <a href="/connect" class="text-navy font-semibold hover:underline">leave your details</a>.
      </p>
    </div>
  </section>

  <script>
    const cards = document.querySelectorAll<HTMLElement>('.ministry-card');

    cards.forEach((card) => {
      const toggleBtn = card.querySelector<HTMLButtonElement>('.ministry-toggle');
      const detail = card.querySelector<HTMLElement>('.ministry-detail');
      const chevron = card.querySelector<HTMLElement>('.ministry-chevron');
      const label = card.querySelector<HTMLElement>('.ministry-toggle-label');

      if (!toggleBtn || !detail) return;

      const setExpanded = (expanded: boolean) => {
        detail.classList.toggle('hidden', !expanded);
        toggleBtn.setAttribute('aria-expanded', String(expanded));
        chevron?.classList.toggle('rotate-180', expanded);
        if (label) label.textContent = expanded ? 'Show less' : 'Learn more';
      };

      const toggle = () => {
        setExpanded(toggleBtn.getAttribute('aria-expanded') !== 'true');
      };

      // The whole card is a large tap target; the button is the
      // keyboard/screen-reader control, so stop it double-toggling.
      card.addEventListener('click', toggle);
      toggleBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        toggle();
      });
      detail.querySelector('a')?.addEventListener('click', (e) => e.stopPropagation());
    });
  </script>

</Layout>
