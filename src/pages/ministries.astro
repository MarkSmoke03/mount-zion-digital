---
import Layout from '../layouts/Layout.astro';

interface Ministry {
  id: string;
  name: string;
  description: string;
  image: string;
  imageAlt: string;
  /** Posters are shown whole (letterboxed) instead of cropped like photos. */
  poster?: boolean;
}

const ministries: Ministry[] = [
  {
    id: 'garage',
    name: 'The Garage (Youth)',
    description:
      'Empowering the next generation. High-energy worship and relevant teaching for young people. The Garage is church like you have never experienced before.',
    image: '/images/garage-youth.jpg',
    imageAlt: 'Young people from The Garage youth ministry',
  },
  {
    id: 'womens',
    name: "Women's Ministry",
    description:
      'Growing together in faith. Equipping our daughters of Zion to fulfill their strategic roles in family, governance, and commerce.',
    image: '/images/daughters-of-zion.jpg',
    imageAlt: "Members of the Women's Ministry worshipping together",
  },
  {
    id: 'mens',
    name: "Men's Ministry",
    description:
      'Building godly men. His Men is dedicated to raising leaders who provide spiritual foundation and discipleship for their homes and communities.',
    image: '/images/mens-ministry.jpg',
    imageAlt: "Members of the Men's Ministry gathered outdoors",
  },
  {
    id: 'nextgen',
    name: 'Next Generation',
    description:
      'Raising the next leaders in Christ. Grounding the youngest among us in biblical truth to permanently set them on the path of kingdom assignment.',
    image: '/images/next-gen.jpg',
    imageAlt: 'Children in the Next Generation ministry',
  },
  {
    id: 'community',
    name: 'Community Life and Care',
    description:
      'Building a supportive church family. Providing practical solutions, fellowship, and care to ensure nobody walks the journey of faith alone.',
    image: '/images/community-life.jpg',
    imageAlt: 'Church families sharing fellowship',
  },
  {
    id: 'spiritual',
    name: 'Spiritual Foundation',
    description:
      'Grounding lives in biblical truth. Through classes like "Days of Rain", we equip members with the necessary wisdom for ministry at our local assembly.',
    image: '/images/days-of-rain-poster.jpg',
    imageAlt: 'Days of Rain discipleship class poster',
    poster: true,
  },
];
---

<Layout
  title="Get Connected"
  description="Find your place at Mount Zion Christian Centre Kitwe: The Garage youth ministry, Women's and Men's Ministries, Next Generation, Community Life and Care, and Spiritual Foundation."
>

  <section class="bg-gray-900 text-white py-16 md:py-20 px-6 text-center">
    <h1 class="text-4xl md:text-5xl mb-4 font-bold">Get Connected</h1>
    <p class="max-w-2xl mx-auto text-gray-400 text-lg leading-relaxed">
      Grounding lives in biblical truth. Whether you're seeking to serve or to grow, there is a place for you in the Mount Zion family.
    </p>
  </section>

  <section class="max-w-7xl mx-auto my-16 md:my-20 px-6">
    <!-- min(100%, 320px) keeps cards from overflowing narrow phone screens -->
    <div class="grid grid-cols-[repeat(auto-fit,minmax(min(100%,320px),1fr))] gap-8 md:gap-10 items-start">
      {ministries.map((m) => (
        <div class="ministry-card cursor-pointer border border-gray-200 rounded-lg overflow-hidden bg-white transition-all duration-200 hover:shadow-lg hover:border-navy/30">
          <img
            src={m.image}
            alt={m.imageAlt}
            loading="lazy"
            decoding="async"
            width="800"
            height="450"
            class:list={['w-full h-[200px]', m.poster ? 'object-contain bg-gray-50' : 'object-cover']}
          />
          <div class="p-6 md:p-8">
            <h2 class="text-2xl mb-3 text-gray-900 font-bold">{m.name}</h2>
            <p class="text-gray-600 text-[15px] leading-relaxed mb-0">{m.description}</p>
            <div id={`detail-${m.id}`} class="ministry-detail hidden mt-5 pt-5 border-t border-gray-100">
              <p class="text-gray-600 text-[15px] leading-relaxed mb-4">
                Want to get plugged into {m.name}? Reach out through our Connect page and we'll point you in the right direction.
              </p>
              <a href="/connect" class="text-navy font-semibold no-underline hover:underline text-sm transition-colors">Get in touch →</a>
            </div>
            <button type="button" class="ministry-toggle mt-4 flex items-center gap-1.5 text-navy font-semibold text-sm transition-colors hover:text-navy-dark" aria-expanded="false" aria-controls={`detail-${m.id}`}>
              <span class="ministry-toggle-label">Tap to learn more</span>
              <svg class="ministry-chevron w-4 h-4 transition-transform duration-200" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
              </svg>
            </button>
          </div>
        </div>
      ))}
    </div>
  </section>

  <script>
    const cards = document.querySelectorAll<HTMLElement>('.ministry-card');

    cards.forEach((card) => {
      const toggleBtn = card.querySelector<HTMLButtonElement>('.ministry-toggle');
      const detail = card.querySelector<HTMLElement>('.ministry-detail');
      const chevron = card.querySelector<HTMLElement>('.ministry-chevron');
      const label = card.querySelector<HTMLElement>('.ministry-toggle-label');

      if (!toggleBtn || !detail) return;

      const setExpanded = (expanded: boolean) => {
        detail.classList.toggle('hidden', !expanded);
        toggleBtn.setAttribute('aria-expanded', String(expanded));
        chevron?.classList.toggle('rotate-180', expanded);
        if (label) label.textContent = expanded ? 'Tap to close' : 'Tap to learn more';
      };

      const toggle = () => {
        setExpanded(toggleBtn.getAttribute('aria-expanded') !== 'true');
      };

      // The whole card is a large tap target; the button is the
      // keyboard/screen-reader control, so stop it double-toggling.
      card.addEventListener('click', toggle);
      toggleBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        toggle();
      });
      detail.querySelector('a')?.addEventListener('click', (e) => e.stopPropagation());
    });
  </script>

</Layout>
