---
import Layout from '../layouts/Layout.astro';

const accounts = [
  {
    label: 'FNB Account No.',
    display: '63022071326',
    copy: '63022071326',
    extra: { label: 'Swift Code', value: 'FIRNZMLX' },
  },
  {
    label: 'MTN Mobile Money',
    display: '+260 762 165 335',
    copy: '+260762165335',
  },
];
---

<Layout
  title="Partner With Us"
  description="Partner with Mount Zion Christian Centre Kitwe in buying land to build the Lord's house. Give through FNB or MTN Mobile Money with reference LAND."
  image="/images/og-partner.jpg"
>

  <section class="bg-gray-900 text-white py-16 md:py-20 px-6 text-center">
    <p class="text-gold text-sm font-semibold tracking-widest uppercase mb-3">Church Land Project</p>
    <h1 class="text-4xl md:text-5xl mb-4 font-bold">Partner With Us</h1>
    <p class="max-w-2xl mx-auto text-gray-400 text-lg leading-relaxed">
      The Lord has placed it upon our hearts to build Him a house, and we invite you to join us in this divine calling. Partner with us in the purchase of land for this purpose and be a part of the blessing as we come together to build the Lord's house.
    </p>
  </section>

  <section class="max-w-5xl mx-auto my-12 md:my-16 px-4 sm:px-6 grid grid-cols-1 md:grid-cols-[1fr_320px] gap-10 items-start">

    <!-- Payment details come first: this is what visitors came to do -->
    <div>
      <div class="bg-white rounded-lg border border-gray-200 shadow-sm overflow-hidden">
        <div class="bg-navy text-white text-center py-4 px-6">
          <h2 class="text-xl font-bold m-0">For Partnership</h2>
        </div>

        <div class="p-6 md:p-8 flex flex-col gap-6">
          {accounts.map((a) => (
            <div class="pb-6 border-b border-gray-100 last:border-b-0 last:pb-0">
              <p class="text-sm font-semibold text-gray-500 uppercase tracking-wide mb-2">{a.label}</p>
              <div class="flex items-center gap-3 flex-wrap">
                <span class="text-2xl font-bold text-gray-900 tracking-wide select-all">{a.display}</span>
                <button
                  type="button"
                  class="copy-btn border border-navy text-navy hover:bg-navy hover:text-white text-sm font-semibold px-3 py-1.5 rounded transition-colors"
                  data-copy={a.copy}
                  aria-label={`Copy ${a.label}`}
                >Copy</button>
              </div>
              {a.extra && (
                <p class="text-gray-600 text-sm mt-2 mb-0">{a.extra.label}: <span class="font-semibold text-gray-800 select-all">{a.extra.value}</span></p>
              )}
            </div>
          ))}
        </div>

        <div class="bg-gray-50 border-t border-gray-100 text-center py-4 px-6">
          <p class="text-gray-700 text-sm m-0">Please use reference: <span class="font-bold text-gray-900">"LAND"</span></p>
        </div>
      </div>

      <p id="copy-status" class="sr-only" aria-live="polite"></p>

      <p class="text-gray-500 text-sm mt-6">
        Questions about the land project? <a href="/connect" class="text-navy font-semibold no-underline hover:underline">Reach out to us</a> and we'll be glad to share more.
      </p>
    </div>

    <img
      src="/images/partner-land-project.jpg"
      alt="Partner With Us – Church Land Project poster with the same account details"
      loading="lazy"
      decoding="async"
      width="864"
      height="1080"
      class="w-full max-w-[320px] mx-auto h-auto rounded-lg shadow-md"
    />
  </section>

  <script>
    const status = document.getElementById('copy-status');

    document.querySelectorAll<HTMLButtonElement>('.copy-btn').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const value = btn.dataset.copy;
        if (!value) return;

        let copied = false;
        try {
          await navigator.clipboard.writeText(value);
          copied = true;
        } catch {
          // Older phones/browsers without the Clipboard API: fall back to a
          // hidden textarea + execCommand, which most of them still support.
          const ta = document.createElement('textarea');
          ta.value = value;
          ta.setAttribute('readonly', '');
          ta.style.position = 'fixed';
          ta.style.opacity = '0';
          document.body.appendChild(ta);
          ta.select();
          try { copied = document.execCommand('copy'); } catch { copied = false; }
          ta.remove();
        }

        const original = 'Copy';
        btn.textContent = copied ? 'Copied!' : 'Press and hold the number to copy';
        if (status) status.textContent = copied ? `${value} copied` : '';
        setTimeout(() => { btn.textContent = original; }, copied ? 1500 : 3000);
      });
    });
  </script>

</Layout>
