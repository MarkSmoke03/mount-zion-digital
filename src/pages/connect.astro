---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Connect With Us">
  <section class="bg-gray-100 py-20 px-6 text-center">
    <h1 class="text-4xl md:text-5xl mb-4 text-gray-900 font-bold">Connect With Us</h1>
    <p class="max-w-2xl mx-auto text-gray-600 text-lg leading-relaxed">
      Whether you are a first-time visitor or a long-time member, we would love to hear from you and help you get plugged into the Mount Zion family.
    </p>
  </section>

  <section class="max-w-4xl mx-auto my-20 px-6">
    <div class="bg-white p-8 md:p-10 rounded-lg border border-gray-200 shadow-sm relative">

      <!-- Success Message -->
      <div id="success-message" class="hidden bg-green-50 border border-green-200 text-green-800 p-4 rounded mb-6 text-center" role="status" aria-live="polite" tabindex="-1">
        <h3 class="font-bold text-lg">Thank you!</h3>
        <p>Your details have been successfully submitted. We will be in touch soon.</p>
      </div>

      <!-- Error Message -->
      <div id="error-message" class="hidden bg-red-50 border border-red-200 text-red-800 p-4 rounded mb-6 text-center" role="alert">
        <p>Something went wrong sending your details. Please check your connection and try again, or call us at <a href="tel:+260962216561" class="font-semibold underline">+260 962 216 561</a>.</p>
      </div>

      <form id="mtz-connect-form" class="flex flex-col gap-6">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div>
            <label for="fullName" class="block text-sm font-semibold text-gray-700 mb-2">Full Name *</label>
            <input type="text" id="fullName" name="fullName" required class="w-full px-4 py-3 border border-gray-300 rounded text-base focus:outline-none focus:border-navy focus:ring-1 focus:ring-navy" />
          </div>
          <div>
            <label for="phoneNumber" class="block text-sm font-semibold text-gray-700 mb-2">Phone Number *</label>
            <input type="tel" id="phoneNumber" name="phoneNumber" required class="w-full px-4 py-3 border border-gray-300 rounded text-base focus:outline-none focus:border-navy focus:ring-1 focus:ring-navy" />
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div>
            <label for="location" class="block text-sm font-semibold text-gray-700 mb-2">Area of Residence (Location) *</label>
            <input type="text" id="location" name="location" required placeholder="e.g., Riverside, Nkana East" class="w-full px-4 py-3 border border-gray-300 rounded text-base focus:outline-none focus:border-navy focus:ring-1 focus:ring-navy" />
          </div>
          <div>
            <label for="email" class="block text-sm font-semibold text-gray-700 mb-2">Email Address (Optional)</label>
            <input type="email" id="email" name="email" class="w-full px-4 py-3 border border-gray-300 rounded text-base focus:outline-none focus:border-navy focus:ring-1 focus:ring-navy" />
          </div>
        </div>

        <div>
          <label for="connectionType" class="block text-sm font-semibold text-gray-700 mb-2">I am a...</label>
          <select id="connectionType" name="connectionType" class="w-full px-4 py-3 border border-gray-300 rounded text-base bg-white focus:outline-none focus:border-navy focus:ring-1 focus:ring-navy">
            <option value="first-time">First-time Visitor</option>
            <option value="returning">Returning Visitor</option>
            <option value="regular">Regular Member</option>
          </select>
        </div>

        <button id="submit-btn" type="submit" class="bg-navy hover:bg-navy-dark text-white text-base font-semibold py-3 px-7 rounded mt-3 transition-colors cursor-pointer border-none self-start">
          Submit Details
        </button>
      </form>
    </div>
  </section>
</Layout>

<script>
  // Google Apps Script Web App endpoint (owned by mountzionkitweconnect@gmail.com)
  const scriptURL = 'https://script.google.com/macros/s/AKfycbxDL7rJpvXp4O1niQorK2L2HuVe6iHErY6dBIyT1Mt14vpwqhsF0NtyQLo-Mwlz_Dtx3g/exec';
  const form = document.getElementById('mtz-connect-form') as HTMLFormElement;
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
  const successMessage = document.getElementById('success-message') as HTMLElement;
  const errorMessage = document.getElementById('error-message') as HTMLElement;

  if (form && submitBtn && successMessage && errorMessage) {
    const setSubmitting = (isSubmitting: boolean) => {
      submitBtn.disabled = isSubmitting;
      submitBtn.innerText = isSubmitting ? 'Submitting...' : 'Submit Details';
      submitBtn.classList.toggle('opacity-70', isSubmitting);
      submitBtn.classList.toggle('cursor-not-allowed', isSubmitting);
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      errorMessage.classList.add('hidden');
      setSubmitting(true);

      // Apps Script Web Apps never send back an Access-Control-Allow-Origin
      // header, so a normal fetch() throws a CORS error in the browser even
      // when Apps Script received and processed the data successfully.
      // mode: 'no-cors' avoids that false negative. The trade-off: the
      // response becomes "opaque", so this can only confirm the request was
      // sent - not that your doPost() logic ran without an internal error.
      const controller = new AbortController();
      const timeoutId = setTimeout(() => controller.abort(), 15000);

      try {
        await fetch(scriptURL, {
          method: 'POST',
          mode: 'no-cors',
          body: new FormData(form),
          signal: controller.signal,
        });
        form.classList.add('hidden');
        successMessage.classList.remove('hidden');
        successMessage.focus();
      } catch (error) {
        console.error('Connect form submission failed:', error);
        errorMessage.classList.remove('hidden');
        setSubmitting(false);
      } finally {
        clearTimeout(timeoutId);
      }
    });
  }
</script>
